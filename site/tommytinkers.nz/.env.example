# Postgres container credentials (used by both the db and app services in docker-compose.yml)
POSTGRES_USER=tommytinkers
POSTGRES_PASSWORD=
POSTGRES_DB=tommytinkers

# When running via docker-compose, the app connects to the db service by name, not localhost.
# For local (non-Docker) development, point this at your own local/dev Postgres instance instead.
DATABASE_URL="postgresql://tommytinkers:<POSTGRES_PASSWORD>@db:5432/tommytinkers"

# Auth.js
AUTH_SECRET=            # generate via `npx auth secret`
AUTH_URL="https://tommytinkers.nz"

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID)
# Authorized redirect URI: https://tommytinkers.nz/api/auth/callback/google (+ http://localhost:3000/... for dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# One-off bootstrap: used only by scripts/promote-admin.ts to promote the first admin account
INITIAL_ADMIN_EMAIL=

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

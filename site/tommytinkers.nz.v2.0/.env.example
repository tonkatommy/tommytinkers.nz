# Local development only. In Docker the app builds DATABASE_URL itself from
# the Compose secret (see docker-entrypoint.sh), so this file is not used there.
DATABASE_URL="postgresql://tommytinkers:change-me@localhost:5432/tommytinkers"

# --- Accounts (Better Auth) ---
# Signs session cookies. Make your own: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Where the site is reached. Links in emails are built from it.
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Each feature switches on when its keys are present.
# Google sign-in (Google Cloud Console -> Credentials -> OAuth client).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Cloudflare Turnstile, the bot check on sign-up.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Resend. Without a key, emails are written to .tmp/emails instead of sent
# (handy locally: open the newest file to get a verification link).
RESEND_API_KEY=""
EMAIL_FROM="tommy tinkers NZ <hello@tommytinkers.nz>"

# Root-level ignores. Each app keeps its own, more specific rules in
# site/tommytinkers.nz/.gitignore and site/tommytinkers.nz.v2.0/.gitignore
# (Next build output, Prisma client, etc.).

# Dependencies
node_modules/

# Next.js build output
.next/

# Env files: real credentials never get committed, the example does
.env*
!.env.example

# TypeScript incremental build info
*.tsbuildinfo

# Logs
logs/
*.log

# OS clutter
.DS_Store

# Local Claude Code settings
.claude

# Files Claude saves to the desktop app's output folder (scratch, not project source)
Claude outputs/

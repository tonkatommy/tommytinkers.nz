# Root-level ignores. The app keeps its own, more specific rules in
# site/tommytinkers.nz.old/.gitignore (Next build output, Prisma client, etc.).

# Dependencies
node_modules/

# Next.js build output
.next/

# Env files: real credentials never get committed, the example does
.env*
!.env.example

# TypeScript incremental build info
*.tsbuildinfo

# Logs
logs/
*.log

# OS clutter
.DS_Store

# Local Claude Code settings
.claude

# Copy to deploy/.env on the server. Never commit the real file.

POSTGRES_USER=tommytinkers
POSTGRES_DB=tommytinkers

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
TUNNEL_TOKEN=
# Separate tunnel for staging.tommytinkers.nz (behind Cloudflare Access)
STAGING_TUNNEL_TOKEN=

# --- Accounts (Better Auth) ---
# Signs session cookies. Make one per environment: openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The public address. Links in emails and the Google redirect are built from it.
BETTER_AUTH_URL=https://tommytinkers.nz

# Google sign-in. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile (the bot check on sign-up)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend. In production the app refuses to send without it.
RESEND_API_KEY=
EMAIL_FROM=tommy tinkers NZ <hello@tommytinkers.nz>

# Staging puts its own values for all of the above in deploy/.env.staging
# (BETTER_AUTH_URL=https://staging.tommytinkers.nz, its own secret, Google
# test credentials, and a Resend key limited to your own address).

# Days of nightly encrypted database dumps to keep. The privacy policy says 30,
# so only change this together with the policy.
BACKUP_KEEP_DAYS=30

# The database password is NOT here. Create it once with:
#   openssl rand -hex 32 > deploy/secrets/db_password.txt
# Hex only, because it is placed straight into a connection URL.
#
# Backups are encrypted to an age public key, also kept in deploy/secrets/.
# Make the key pair on your own computer, not the server:
#   age-keygen -o backup_age.key
#   age-keygen -y backup_age.key > deploy/secrets/backup_age.pub
# Keep backup_age.key in your password manager, off the server. Without it the
# backups can't be restored.
